<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Scripts\Projectile.fsx" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Scripts\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="TestUtilities.fs" />
    <Compile Include="TuplesTests.fs" />
    <Compile Include="ColorTests.fs" />
    <Compile Include="CanvasTests.fs" />
    <Compile Include="MatrixTests.fs" />
    <Compile Include="Program.fs" />
    <None Include="Scripts\Projectile.fsx" />
    <None Include="Scripts\ProjectilePPM.fsx" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.2.0" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.0" />
    <PackageReference Include="coverlet.collector" Version="1.0.1" />
    <PackageReference Include="FsUnit.xUnit" Version="3.8.0" />
    <ProjectReference Include="..\Raytracer\Raytracer.fsproj" />
  </ItemGroup>
</Project>
