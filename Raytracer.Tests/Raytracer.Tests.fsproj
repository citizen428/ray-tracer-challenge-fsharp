<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="Scripts\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Scripts\Ch01-Projectile.fsx" />
    <None Include="Scripts\Ch02-ProjectilePPM.fsx" />
    <None Include="Scripts\Ch04-Clock.fsx" />
    <None Include="Scripts\Ch05-SphereShadow.fsx" />
    <None Include="Scripts\Ch06-SphereLighting.fsx" />
    <None Include="Scripts\Ch07-Scene.fsx" />
    <None Include="Scripts\Ch09-Plane.fsx" />
    <None Include="Scripts\Ch10-Patterns.fsx" />
    <Compile Include="TestUtilities.fs" />
    <Compile Include="VectorTests.fs" />
    <Compile Include="PointTests.fs" />
    <Compile Include="ColorTests.fs" />
    <Compile Include="CanvasTests.fs" />
    <Compile Include="MatrixTests.fs" />
    <Compile Include="TransformationTests.fs" />
    <Compile Include="RayTests.fs" />
    <Compile Include="IntersectionTests.fs" />
    <Compile Include="LightTests.fs" />
    <Compile Include="PatternTests.fs" />
    <Compile Include="MaterialTests.fs" />
    <Compile Include="ShapeTests.fs" />
    <Compile Include="SphereTests.fs" />
    <Compile Include="PlaneTests.fs" />
    <Compile Include="ComputationTests.fs" />
    <Compile Include="WorldTest.fs" />
    <Compile Include="CameraTests.fs" />
    <Compile Include="Program.fs" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="FsUnit.xUnit" Version="4.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.10.0" />
    <PackageReference Include="coverlet.collector" Version="3.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="..\Raytracer\Raytracer.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="5.0.2" />
  </ItemGroup>
</Project>